# Copy to .env and adjust. Never commit .env.

# Used by docker-compose to create the database container.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# Used when running the API outside Docker (host port 5433 maps to the db container).
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag
DB_CONNECT_TIMEOUT_SECONDS=3

# Ingestion limits. Upload size is in bytes; chunk sizes are in characters.
MAX_UPLOAD_BYTES=10485760
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
MAX_CHUNK_SIZE=4000

# Test database used by pytest (created automatically on the same server).
TEST_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag_test
ADMIN_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5433/rag

# Required only for POST /query (phase 4). Leave empty until then.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

EMBEDDING_MODEL=intfloat/multilingual-e5-small

LOG_LEVEL=INFO
